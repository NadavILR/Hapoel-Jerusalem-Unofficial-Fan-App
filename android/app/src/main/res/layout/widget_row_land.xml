<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget lying down (landscape: a wide, low row): the crests at the two ends, sized to the row's height;
     in the middle the competition / stage and the day, date and time on the right, and the countdown on the left -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_bg" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layoutDirection="rtl">
  <ImageView android:id="@+id/w_home_crest" android:layout_width="40dp" android:layout_height="match_parent" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical|start" android:paddingStart="10dp" android:paddingEnd="10dp">
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/w_comp" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:textColor="#FFFFFF" android:textSize="13dp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/w_when" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:textColor="#E6FFFFFF" android:textSize="12dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="2dp" />
    </LinearLayout>
  <TextView android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/w_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_box" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="#FFFFFF" android:textSize="13dp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
  <LinearLayout android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layoutDirection="ltr" android:layout_marginEnd="6dp">
      <LinearLayout android:id="@+id/w_days_box" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="34dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_box" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/w_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16dp" android:textStyle="bold" android:includeFontPadding="false" android:fontFeatureSettings="tnum" android:text="00" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="9dp" android:includeFontPadding="false" android:text="ימים" />
      </LinearLayout>
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="34dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_box" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/w_hours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16dp" android:textStyle="bold" android:includeFontPadding="false" android:fontFeatureSettings="tnum" android:text="00" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="9dp" android:includeFontPadding="false" android:text="שעות" />
      </LinearLayout>
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="34dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_box" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
        <FrameLayout android:id="@+id/w_mm_clip" android:layout_width="19dp" android:layout_height="wrap_content" android:layoutDirection="ltr"><Chronometer android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/w_chrono" android:layout_width="120dp" android:layout_height="wrap_content" android:layout_gravity="start" android:gravity="start" android:textAlignment="viewStart" android:layoutDirection="ltr" android:textDirection="ltr" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="16dp" android:textStyle="bold" android:includeFontPadding="false" android:fontFeatureSettings="tnum" /></FrameLayout>
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="9dp" android:includeFontPadding="false" android:text="דקות" />
      </LinearLayout>
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="34dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_box" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
        <FrameLayout android:id="@+id/w_ss_clip" android:layout_width="19dp" android:layout_height="wrap_content" android:layoutDirection="ltr"><Chronometer android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/w_chrono2" android:layout_width="120dp" android:layout_height="wrap_content" android:layout_gravity="end" android:gravity="end" android:textAlignment="viewEnd" android:layoutDirection="ltr" android:textDirection="ltr" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="16dp" android:textStyle="bold" android:includeFontPadding="false" android:fontFeatureSettings="tnum" /></FrameLayout>
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="9dp" android:includeFontPadding="false" android:text="שניות" />
      </LinearLayout>
  </LinearLayout>
  <ImageView android:id="@+id/w_away_crest" android:layout_width="40dp" android:layout_height="match_parent" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
</LinearLayout>
