<?xml version="1.0" encoding="utf-8"?>
<!-- Next-game widget (5×1), in the clock widget's style: dark glass, the club's red panel with the crest on the right;
     both crests, the opponent, the competition and round, the day / date / time, and the countdown in four boxes -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@drawable/cw3_bg" android:clipToOutline="true" android:layoutDirection="rtl">
  <FrameLayout android:id="@+id/w_club" android:layout_width="54dp" android:layout_height="match_parent" android:background="@drawable/cw_club_bg">
    <ImageView android:id="@+id/w_clubimg" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
  </FrameLayout>
  <LinearLayout android:id="@+id/w_main" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
      <!-- the user's design: the crests above the name (the host on the right, the guest on the left, over it) -->
      <FrameLayout android:id="@+id/w_crests" android:layout_width="48dp" android:layout_height="28dp">
        <ImageView android:id="@+id/w_me" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="start" android:background="@drawable/cw_disc" android:padding="1.5dp" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/w_opp" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="end" android:background="@drawable/cw_disc" android:padding="1.5dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
      </FrameLayout>
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_op" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#FFFFFF" android:textSize="14dp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_comp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#D9FFFFFF" android:textSize="11dp" android:maxLines="1" android:ellipsize="end" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_when" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#D9FFFFFF" android:textSize="11dp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="horizontal" android:layoutDirection="ltr">
      <LinearLayout android:id="@+id/w_days_box" android:layout_width="35dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw2_box" android:paddingTop="4dp" android:paddingBottom="5dp">
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="00" />
        <TextView android:id="@+id/w_bl1" android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#B3FFFFFF" android:textSize="8dp" android:text="ימים" />
      </LinearLayout>
      <LinearLayout android:id="@+id/w_b2" android:layout_width="35dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw2_box" android:paddingTop="4dp" android:paddingBottom="5dp">
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_hours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="00" />
        <TextView android:id="@+id/w_bl2" android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#B3FFFFFF" android:textSize="8dp" android:text="שעות" />
      </LinearLayout>
      <LinearLayout android:id="@+id/w_b3" android:layout_width="35dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw2_box" android:paddingTop="4dp" android:paddingBottom="5dp">
        <FrameLayout android:id="@+id/w_mm_clip" android:layout_width="20dp" android:layout_height="wrap_content" android:layoutDirection="ltr">
          <Chronometer android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_chrono" android:layout_width="160dp" android:layout_height="wrap_content" android:layout_gravity="start" android:gravity="start" android:textAlignment="viewStart" android:layoutDirection="ltr" android:textDirection="ltr" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="16dp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
        </FrameLayout>
        <TextView android:id="@+id/w_bl3" android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#B3FFFFFF" android:textSize="8dp" android:text="דקות" />
      </LinearLayout>
      <LinearLayout android:id="@+id/w_b4" android:layout_width="35dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw2_box" android:paddingTop="4dp" android:paddingBottom="5dp">
        <FrameLayout android:id="@+id/w_ss_clip" android:layout_width="20dp" android:layout_height="wrap_content" android:layoutDirection="ltr">
          <Chronometer android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_chrono2" android:layout_width="160dp" android:layout_height="wrap_content" android:layout_gravity="end" android:gravity="end" android:textAlignment="viewEnd" android:layoutDirection="ltr" android:textDirection="ltr" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="16dp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
        </FrameLayout>
        <TextView android:id="@+id/w_bl4" android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#B3FFFFFF" android:textSize="8dp" android:text="שניות" />
      </LinearLayout>
    </LinearLayout>
    <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/cw2_box" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:textColor="#FFFFFF" android:textSize="10.5dp" android:textStyle="bold" android:maxLines="2" android:gravity="center" android:visibility="gone" />
  </LinearLayout>
</LinearLayout>
