<?xml version="1.0" encoding="utf-8"?>
<!-- Clock widget, 5×2 (design base 362 × 195dp; ClockWidget scales it to the real size). Right: the club on red – crest,
     name, and the titles with the silhouettes of the real trophies. Left, on dark glass: the clock; the day, date and
     Hebrew date centred between the clock and the card; the next game – both crests, the opponent, the competition and
     round, the day/date and the time, and the countdown in four boxes as in the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/k_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@drawable/cw2_bg" android:clipToOutline="true" android:layoutDirection="rtl">
  <LinearLayout android:id="@+id/k_club" android:layout_width="122dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/cw_club_bg" android:padding="12dp">
    <ImageView android:id="@+id/k_crest" android:layout_width="48dp" android:layout_height="48dp" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
    <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#FFFFFF" android:textSize="11.5dp" android:textStyle="bold" android:maxLines="1" android:text="הפועל ירושלים" />
    <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:minHeight="4dp" />
    <LinearLayout android:id="@+id/k_titles" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <LinearLayout android:id="@+id/k_r1" android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/k_i1" android:layout_width="18dp" android:layout_height="16dp" android:scaleType="fitCenter" android:src="@drawable/cw_t_league" android:importantForAccessibility="no" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_l1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="#FFFFFF" android:textSize="10dp" android:maxLines="1" android:text="אליפויות" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_n1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFE08A" android:textSize="11.5dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="2" />
      </LinearLayout>
      <FrameLayout android:id="@+id/k_d1" android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/cw2_line" />
      <LinearLayout android:id="@+id/k_r2" android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/k_i2" android:layout_width="18dp" android:layout_height="16dp" android:scaleType="fitCenter" android:src="@drawable/cw_t_state" android:importantForAccessibility="no" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_l2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="#FFFFFF" android:textSize="10dp" android:maxLines="1" android:text="גביע המדינה" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_n2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFE08A" android:textSize="11.5dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="8" />
      </LinearLayout>
      <FrameLayout android:id="@+id/k_d2" android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/cw2_line" />
      <LinearLayout android:id="@+id/k_r3" android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/k_i3" android:layout_width="18dp" android:layout_height="16dp" android:scaleType="fitCenter" android:src="@drawable/cw_t_winner" android:importantForAccessibility="no" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_l3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="#FFFFFF" android:textSize="10dp" android:maxLines="1" android:text="גביע ווינר" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_n3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFE08A" android:textSize="11.5dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="7" />
      </LinearLayout>
      <FrameLayout android:id="@+id/k_d3" android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/cw2_line" />
      <LinearLayout android:id="@+id/k_r4" android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/k_i4" android:layout_width="18dp" android:layout_height="16dp" android:scaleType="fitCenter" android:src="@drawable/cw_t_uleb" android:importantForAccessibility="no" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_l4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="#FFFFFF" android:textSize="10dp" android:maxLines="1" android:text="גביע יול&quot;ב" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_n4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFE08A" android:textSize="11.5dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="1" />
      </LinearLayout>
      <FrameLayout android:id="@+id/k_d4" android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/cw2_line" />
      <LinearLayout android:id="@+id/k_r5" android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/k_i5" android:layout_width="18dp" android:layout_height="16dp" android:scaleType="fitCenter" android:src="@drawable/cw_t_super" android:importantForAccessibility="no" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_l5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="#FFFFFF" android:textSize="10dp" android:maxLines="1" android:text="סופרקאפ" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_n5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFE08A" android:textSize="11.5dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="1" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/k_main" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
    <!-- the clock: hours and minutes big, the seconds beside them smaller, on the same baseline (both tick by themselves) -->
    <LinearLayout android:id="@+id/k_clock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center|bottom" android:baselineAligned="false" android:layoutDirection="ltr">
      <TextClock android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textColor="#FFFFFF" android:textSize="52dp" android:textStyle="bold" android:letterSpacing="-0.03" android:fontFeatureSettings="tnum" android:maxLines="1" />
      <TextClock android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_sec" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:background="@drawable/cw_sec_pill" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:gravity="center" android:format24Hour="ss" android:format12Hour="ss" android:textColor="#D21919" android:textSize="17dp" android:textStyle="bold" android:letterSpacing="-0.01" android:fontFeatureSettings="tnum" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/k_dates" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center" android:paddingBottom="6dp">
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="10.5dp" android:textStyle="bold" android:maxLines="1" android:text="יום רביעי" />
      <FrameLayout android:id="@+id/k_s1" android:layout_width="1dp" android:layout_height="10dp" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:background="@drawable/cw2_sep" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_greg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E0FFFFFF" android:textSize="10.5dp" android:maxLines="1" android:text="18.11.2026" />
      <FrameLayout android:id="@+id/k_s2" android:layout_width="1dp" android:layout_height="10dp" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:background="@drawable/cw2_sep" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_heb" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E0FFFFFF" android:textSize="10.5dp" android:maxLines="1" android:text="ח' בכסלו ה'תשפ&quot;ז" />
    </LinearLayout>
    <LinearLayout android:id="@+id/k_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/cw2_card" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="7dp" android:paddingBottom="7dp">
      <LinearLayout android:id="@+id/k_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:id="@+id/k_crests" android:layout_width="34dp" android:layout_height="20dp">
          <ImageView android:id="@+id/k_me" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="start" android:background="@drawable/cw_disc" android:padding="1dp" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
          <ImageView android:id="@+id/k_opp" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="end" android:background="@drawable/cw_disc" android:padding="1dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout android:id="@+id/k_who" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:orientation="vertical">
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_op" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="9dp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_comp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#BFFFFFFF" android:textSize="9dp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/k_when" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:orientation="vertical" android:gravity="end">
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_wd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#BFFFFFFF" android:textSize="9dp" android:maxLines="1" />
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_wt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#BFFFFFFF" android:textSize="9dp" android:maxLines="1" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:id="@+id/k_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal" android:layoutDirection="ltr">
        <LinearLayout android:id="@+id/k_b1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw2_box" android:paddingTop="4dp" android:paddingBottom="5dp">
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_dd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="19dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="00" />
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_b1l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#B3FFFFFF" android:textSize="8.5dp" android:text="ימים" />
        </LinearLayout>
        <LinearLayout android:id="@+id/k_b2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw2_box" android:paddingTop="4dp" android:paddingBottom="5dp">
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_hh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="19dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="00" />
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_b2l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#B3FFFFFF" android:textSize="8.5dp" android:text="שעות" />
        </LinearLayout>
        <LinearLayout android:id="@+id/k_b3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw2_box" android:paddingTop="4dp" android:paddingBottom="5dp">
          <FrameLayout android:id="@+id/k_mm_clip" android:layout_width="23dp" android:layout_height="wrap_content" android:layoutDirection="ltr">
            <Chronometer android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_mm" android:layout_width="160dp" android:layout_height="wrap_content" android:layout_gravity="start" android:gravity="start" android:textAlignment="viewStart" android:layoutDirection="ltr" android:textDirection="ltr" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="19dp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
          </FrameLayout>
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_b3l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#B3FFFFFF" android:textSize="8.5dp" android:text="דקות" />
        </LinearLayout>
        <LinearLayout android:id="@+id/k_b4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw2_box" android:paddingTop="4dp" android:paddingBottom="5dp">
          <FrameLayout android:id="@+id/k_ss_clip" android:layout_width="23dp" android:layout_height="wrap_content" android:layoutDirection="ltr">
            <Chronometer android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_ss" android:layout_width="160dp" android:layout_height="wrap_content" android:layout_gravity="end" android:gravity="end" android:textAlignment="viewEnd" android:layoutDirection="ltr" android:textDirection="ltr" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="19dp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
          </FrameLayout>
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_b4l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#B3FFFFFF" android:textSize="8.5dp" android:text="שניות" />
        </LinearLayout>
      </LinearLayout>
      <!-- during the game – the user's design: the host's crest on the right, the competition and the stage in the middle,
           the guest's crest on the left; below them the score boxes (the host on the right) with the "לייב" tag, the
           quarter and the game clock between them -->
      <LinearLayout android:id="@+id/k_lhead" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="rtl" android:visibility="gone">
        <ImageView android:id="@+id/k_lhc" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="10dp" android:background="@drawable/cw_disc" android:padding="1.5dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_lt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13dp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_ls" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="-3dp" android:textColor="#FFFFFF" android:textSize="10dp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:id="@+id/k_lac" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="10dp" android:background="@drawable/cw_disc" android:padding="1.5dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
      </LinearLayout>
      <LinearLayout android:id="@+id/k_score" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="rtl" android:visibility="gone">
        <LinearLayout android:id="@+id/k_hbox" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw2_box" android:paddingTop="4dp" android:paddingBottom="5dp" android:paddingStart="4dp" android:paddingEnd="4dp">
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_hs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="20dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="0" />
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_hn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#FFFFFF" android:textSize="9.5dp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/k_mid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:orientation="vertical" android:gravity="center">
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_tag" android:singleLine="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/cw2_live" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="1dp" android:paddingBottom="2dp" android:textColor="#FFFFFF" android:textSize="10dp" android:textStyle="bold" android:text="● לייב" />
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_lq" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#FFFFFF" android:textSize="9.5dp" android:textStyle="bold" android:maxLines="1" />
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_lc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15dp" android:maxLines="1" android:fontFeatureSettings="tnum" />
        </LinearLayout>
        <LinearLayout android:id="@+id/k_abox" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw2_box" android:paddingTop="4dp" android:paddingBottom="5dp" android:paddingStart="4dp" android:paddingEnd="4dp">
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_as" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="20dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="0" />
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_an" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#FFFFFF" android:textSize="9.5dp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
      </LinearLayout>
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/k_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="11dp" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
