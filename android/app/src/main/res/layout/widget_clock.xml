<?xml version="1.0" encoding="utf-8"?>
<!-- Clock widget, 5 columns × 2 rows, transparent: the club crest on the right; a big clock with the day, the date and
     the Hebrew date under it; the club's titles; and a countdown to the next game. White text with a soft shadow so it
     reads on any wallpaper. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/c_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:layoutDirection="rtl">
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:id="@+id/c_crest" android:layout_width="wrap_content" android:layout_height="match_parent" android:maxWidth="96dp" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingStart="8dp">
      <TextClock android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/c_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textColor="#FFFFFF" android:textSize="54dp" android:textStyle="bold" android:includeFontPadding="false" android:layoutDirection="ltr" android:fontFeatureSettings="tnum" android:shadowColor="#B3000000" android:shadowRadius="6" android:shadowDy="1" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/c_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#FFFFFF" android:textSize="13dp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#B3000000" android:shadowRadius="5" android:shadowDy="1" />
    </LinearLayout>
  </LinearLayout>
  <TextView android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/c_titles" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:textColor="#F2FFFFFF" android:textSize="10.5dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#B3000000" android:shadowRadius="5" android:shadowDy="1" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center">
    <TextView android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/c_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12dp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="#B3000000" android:shadowRadius="5" android:shadowDy="1" />
    <TextView android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/c_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:background="@drawable/widget_live" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="1dp" android:paddingBottom="2dp" android:textColor="#D21919" android:textSize="12dp" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false" />
    <Chronometer android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/c_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="#FFFFFF" android:textSize="12dp" android:textStyle="bold" android:includeFontPadding="false" android:layoutDirection="ltr" android:fontFeatureSettings="tnum" android:shadowColor="#B3000000" android:shadowRadius="5" android:shadowDy="1" />
  </LinearLayout>
</LinearLayout>
