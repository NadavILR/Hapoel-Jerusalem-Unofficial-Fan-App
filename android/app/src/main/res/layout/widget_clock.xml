<?xml version="1.0" encoding="utf-8"?>
<!-- Clock widget, 5×2: a dark-glass card in the app's style. One spacing unit everywhere – 10dp padding on every side and
     10dp between the rows; corners 20dp outside, 10dp for what sits in them. Top: the crest, the clock (ticks by itself)
     and the day / date / Hebrew date pills; the club's titles; a red band with the next game and a countdown in four
     boxes (days and hours set by the app, minutes and seconds count down by themselves). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/c_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/cw_bg" android:padding="10dp" android:layoutDirection="rtl">
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:layout_width="64dp" android:layout_height="match_parent" android:maxHeight="64dp" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
    <TextClock android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/c_time" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:gravity="center" android:paddingBottom="4dp" android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textColor="#FFFFFF" android:textSize="56dp" android:textStyle="bold" android:letterSpacing="-0.03" android:layoutDirection="ltr" android:fontFeatureSettings="tnum" android:maxLines="1" android:shadowColor="#59000000" android:shadowRadius="12" android:shadowDy="2" />
    <LinearLayout android:layout_width="116dp" android:layout_height="match_parent" android:maxHeight="66dp" android:orientation="vertical" android:gravity="center">
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/c_day" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/cw_pill_red" android:gravity="center" android:paddingBottom="1dp" android:textColor="#FFFFFF" android:textSize="11dp" android:textStyle="bold" android:maxLines="1" android:text="יום רביעי" />
      <FrameLayout android:layout_width="1dp" android:layout_height="3dp" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/c_greg" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/cw_pill" android:gravity="center" android:paddingBottom="1dp" android:textColor="#FFFFFF" android:textSize="11dp" android:textStyle="bold" android:maxLines="1" android:text="18.11.2026" />
      <FrameLayout android:layout_width="1dp" android:layout_height="3dp" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/c_heb" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/cw_pill" android:gravity="center" android:paddingBottom="1dp" android:textColor="#FFFFFF" android:textSize="11dp" android:textStyle="bold" android:maxLines="1" android:text="ח' בכסלו ה'תשפ&quot;ז" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="22dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/cw_title" android:paddingStart="6dp" android:paddingEnd="6dp">
      <ImageView android:layout_width="10dp" android:layout_height="10dp" android:layout_marginTop="1dp" android:src="@drawable/cw_trophy" android:importantForAccessibility="no" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:textColor="#FFFFFF" android:textSize="11dp" android:textStyle="bold" android:text="2" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_marginTop="1dp" android:textColor="#D9FFFFFF" android:textSize="9.5dp" android:maxLines="1" android:text="אליפויות" />
    </LinearLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:minWidth="4dp" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="22dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/cw_title" android:paddingStart="6dp" android:paddingEnd="6dp">
      <ImageView android:layout_width="10dp" android:layout_height="10dp" android:layout_marginTop="1dp" android:src="@drawable/cw_trophy" android:importantForAccessibility="no" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:textColor="#FFFFFF" android:textSize="11dp" android:textStyle="bold" android:text="8" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_marginTop="1dp" android:textColor="#D9FFFFFF" android:textSize="9.5dp" android:maxLines="1" android:text="גביע המדינה" />
    </LinearLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:minWidth="4dp" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="22dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/cw_title" android:paddingStart="6dp" android:paddingEnd="6dp">
      <ImageView android:layout_width="10dp" android:layout_height="10dp" android:layout_marginTop="1dp" android:src="@drawable/cw_trophy" android:importantForAccessibility="no" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:textColor="#FFFFFF" android:textSize="11dp" android:textStyle="bold" android:text="7" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_marginTop="1dp" android:textColor="#D9FFFFFF" android:textSize="9.5dp" android:maxLines="1" android:text="ווינר" />
    </LinearLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:minWidth="4dp" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="22dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/cw_title" android:paddingStart="6dp" android:paddingEnd="6dp">
      <ImageView android:layout_width="10dp" android:layout_height="10dp" android:layout_marginTop="1dp" android:src="@drawable/cw_trophy" android:importantForAccessibility="no" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:textColor="#FFFFFF" android:textSize="11dp" android:textStyle="bold" android:text="1" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_marginTop="1dp" android:textColor="#D9FFFFFF" android:textSize="9.5dp" android:maxLines="1" android:text="יול&quot;ב" />
    </LinearLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:minWidth="4dp" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="22dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/cw_title" android:paddingStart="6dp" android:paddingEnd="6dp">
      <ImageView android:layout_width="10dp" android:layout_height="10dp" android:layout_marginTop="1dp" android:src="@drawable/cw_trophy" android:importantForAccessibility="no" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:textColor="#FFFFFF" android:textSize="11dp" android:textStyle="bold" android:text="1" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_marginTop="1dp" android:textColor="#D9FFFFFF" android:textSize="9.5dp" android:maxLines="1" android:text="סופרקאפ" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/cw_band" android:paddingStart="10dp" android:paddingEnd="10dp">
    <FrameLayout android:id="@+id/c_crests" android:layout_width="52dp" android:layout_height="30dp">
      <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="start" android:background="@drawable/cw_disc" android:padding="2dp" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
      <ImageView android:id="@+id/c_opp" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="end" android:background="@drawable/cw_disc" android:padding="2dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/c_lb" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E6FFFFFF" android:textSize="9.5dp" android:maxLines="1" android:ellipsize="end" android:text="המשחק הבא" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/c_op" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#FFFFFF" android:textSize="13.5dp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/c_wh" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#F2FFFFFF" android:textSize="10dp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/c_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="horizontal" android:layoutDirection="ltr">
      <LinearLayout android:layout_width="38dp" android:layout_height="38dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw_box" android:paddingBottom="1dp">
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/c_dd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="00" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#EBFFFFFF" android:textSize="8.5dp" android:text="ימים" />
      </LinearLayout>
      <LinearLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="4dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw_box" android:paddingBottom="1dp">
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/c_hh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="00" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#EBFFFFFF" android:textSize="8.5dp" android:text="שעות" />
      </LinearLayout>
      <LinearLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="4dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw_box" android:paddingBottom="1dp">
        <FrameLayout android:id="@+id/c_mm_clip" android:layout_width="19dp" android:layout_height="wrap_content" android:layoutDirection="ltr">
          <Chronometer android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/c_mm" android:layout_width="120dp" android:layout_height="wrap_content" android:layout_gravity="start" android:gravity="start" android:textAlignment="viewStart" android:layoutDirection="ltr" android:textDirection="ltr" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="16dp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
        </FrameLayout>
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#EBFFFFFF" android:textSize="8.5dp" android:text="דקות" />
      </LinearLayout>
      <LinearLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="4dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw_box" android:paddingBottom="1dp">
        <FrameLayout android:id="@+id/c_ss_clip" android:layout_width="19dp" android:layout_height="wrap_content" android:layoutDirection="ltr">
          <Chronometer android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/c_ss" android:layout_width="120dp" android:layout_height="wrap_content" android:layout_gravity="end" android:gravity="end" android:textAlignment="viewEnd" android:layoutDirection="ltr" android:textDirection="ltr" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="16dp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
        </FrameLayout>
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#EBFFFFFF" android:textSize="8.5dp" android:text="שניות" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
