<?xml version="1.0" encoding="utf-8"?>
<!-- Next-game widget (5×1) during the game: the "לייב" tag with the quarter and the game clock, the competition and round,
     and the score between the two crests (the home team on the right) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@drawable/cw3_bg" android:clipToOutline="true" android:layoutDirection="rtl">
  <FrameLayout android:id="@+id/w_club" android:layout_width="54dp" android:layout_height="match_parent" android:background="@drawable/cw_club_bg">
    <ImageView android:id="@+id/w_clubimg" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
  </FrameLayout>
  <LinearLayout android:id="@+id/w_main" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_tag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/cw2_live" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="1dp" android:paddingBottom="2dp" android:textColor="#FFFFFF" android:textSize="9.5dp" android:textStyle="bold" android:text="● לייב" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_clock" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#FFFFFF" android:textSize="11.5dp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum" />
      </LinearLayout>
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_comp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#BFFFFFFF" android:textSize="9dp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageView android:id="@+id/w_home_crest" android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/cw_disc" android:padding="2dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_hs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#FFFFFF" android:textSize="24dp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:textColor="#66FFFFFF" android:textSize="18dp" android:text="–" android:id="@+id/w_dash" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_as" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="24dp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
      <ImageView android:id="@+id/w_away_crest" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="6dp" android:background="@drawable/cw_disc" android:padding="2dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
