<?xml version="1.0" encoding="utf-8"?>
<!-- Next-game widget (5×1) during the game – the user's design: the two crests big at the sides (the host on the
     right), the score boxes over their inner halves, and between them the competition, the stage, the "לייב" tag, the
     quarter and the game clock -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@drawable/cw3_bg" android:clipToOutline="true" android:layoutDirection="rtl">
  <FrameLayout android:id="@+id/w_club" android:layout_width="54dp" android:layout_height="match_parent" android:background="@drawable/cw_club_bg">
    <ImageView android:id="@+id/w_clubimg" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
  </FrameLayout>
  <FrameLayout android:id="@+id/w_main" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:paddingStart="8dp" android:paddingEnd="8dp">
    <ImageView android:id="@+id/w_home_crest" android:layout_width="70dp" android:layout_height="70dp" android:layout_gravity="start|center_vertical" android:background="@drawable/cw_disc" android:padding="7dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/w_away_crest" android:layout_width="70dp" android:layout_height="70dp" android:layout_gravity="end|center_vertical" android:background="@drawable/cw_disc" android:padding="7dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/w_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/w_hbox" android:layout_width="74dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw2_sbox" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="5dp" android:paddingBottom="6dp">
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_hs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="21dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="0" />
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_hn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#FFFFFF" android:textSize="9.5dp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_mid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:orientation="vertical" android:gravity="center">
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_op" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12dp" android:textStyle="bold" android:maxLines="1" />
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_comp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#FFFFFF" android:textSize="9.5dp" android:maxLines="1" />
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_tag" android:singleLine="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:background="@drawable/cw2_live" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="1dp" android:paddingBottom="2dp" android:textColor="#FFFFFF" android:textSize="9.5dp" android:textStyle="bold" android:text="לייב" />
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_q" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#FFFFFF" android:textSize="9.5dp" android:textStyle="bold" android:maxLines="1" />
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14dp" android:maxLines="1" android:fontFeatureSettings="tnum" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_abox" android:layout_width="74dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw2_sbox" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="5dp" android:paddingBottom="6dp">
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_as" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="21dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="0" />
          <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_an" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#FFFFFF" android:textSize="9.5dp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
      </LinearLayout>
  </FrameLayout>
</LinearLayout>
