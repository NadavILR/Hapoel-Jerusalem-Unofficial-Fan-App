<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget lying down, during the game: crests and scores at the ends (home on the right); in the middle
     the competition with "הפועל לייב" on the right and the quarter / clock box on the left -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_bg" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layoutDirection="rtl">
  <ImageView android:id="@+id/w_home_crest" android:layout_width="40dp" android:layout_height="match_parent" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
  <TextView android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/w_hs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#FFFFFF" android:textSize="26dp" android:textStyle="bold" android:includeFontPadding="false" android:fontFeatureSettings="tnum" />
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical|start" android:paddingStart="10dp" android:paddingEnd="8dp">
    <TextView android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/w_comp" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:textColor="#FFFFFF" android:textSize="12dp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14dp" android:textStyle="bold" android:includeFontPadding="false" android:text="הפועל" />
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:background="@drawable/widget_live" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:textColor="#D21919" android:textSize="13dp" android:textStyle="bold" android:includeFontPadding="false" android:text="לייב" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="76dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_box" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_marginEnd="8dp">
    <TextView android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/w_qlabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E6FFFFFF" android:textSize="10dp" android:textStyle="bold" android:includeFontPadding="false" />
    <TextView android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/w_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16dp" android:textStyle="bold" android:includeFontPadding="false" android:layoutDirection="ltr" android:fontFeatureSettings="tnum" android:maxLines="1" />
  </LinearLayout>
  <TextView android:fontFamily="@font/noto_sans_hebrew" android:id="@+id/w_as" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:textColor="#FFFFFF" android:textSize="26dp" android:textStyle="bold" android:includeFontPadding="false" android:fontFeatureSettings="tnum" />
  <ImageView android:id="@+id/w_away_crest" android:layout_width="40dp" android:layout_height="match_parent" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
</LinearLayout>
