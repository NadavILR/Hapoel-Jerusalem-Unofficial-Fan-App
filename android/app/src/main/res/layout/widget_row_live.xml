<?xml version="1.0" encoding="utf-8"?>
<!-- Next-game widget (5×1) during the game, in the clock widget's live style: on the right both crests, the opponent and
     the competition and round; on the left the score in two boxes (the home team on the right, each team's name below its
     score) with the "לייב" tag and the quarter and game clock between them -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@drawable/cw3_bg" android:clipToOutline="true" android:layoutDirection="rtl">
  <FrameLayout android:id="@+id/w_club" android:layout_width="54dp" android:layout_height="match_parent" android:background="@drawable/cw_club_bg">
    <ImageView android:id="@+id/w_clubimg" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
  </FrameLayout>
  <LinearLayout android:id="@+id/w_main" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:id="@+id/w_crests" android:layout_width="30dp" android:layout_height="18dp">
          <ImageView android:id="@+id/w_me" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="start" android:background="@drawable/cw_disc" android:padding="1dp" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
          <ImageView android:id="@+id/w_opp" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="end" android:background="@drawable/cw_disc" android:padding="1dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_op" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#FFFFFF" android:textSize="11.5dp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
      </LinearLayout>
      <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_comp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#BFFFFFFF" android:textSize="9dp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_score" android:layout_width="168dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="horizontal" android:gravity="center_vertical">
      <LinearLayout android:id="@+id/w_hbox" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw2_box" android:paddingStart="3dp" android:paddingEnd="3dp" android:paddingTop="4dp" android:paddingBottom="5dp">
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_hs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="0" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_hn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#B3FFFFFF" android:textSize="8dp" android:maxLines="1" android:ellipsize="end" />
      </LinearLayout>
      <LinearLayout android:id="@+id/w_mid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:orientation="vertical" android:gravity="center">
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_tag" android:singleLine="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/cw2_live" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="1dp" android:paddingBottom="2dp" android:textColor="#FFFFFF" android:textSize="8.5dp" android:textStyle="bold" android:text="● לייב" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="8.5dp" android:textStyle="bold" android:maxLines="2" android:fontFeatureSettings="tnum" />
      </LinearLayout>
      <LinearLayout android:id="@+id/w_abox" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/cw2_box" android:paddingStart="3dp" android:paddingEnd="3dp" android:paddingTop="4dp" android:paddingBottom="5dp">
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_as" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16dp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="0" />
        <TextView android:fontFamily="@font/noto_sans_hebrew" android:includeFontPadding="false" android:id="@+id/w_an" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#B3FFFFFF" android:textSize="8dp" android:maxLines="1" android:ellipsize="end" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
