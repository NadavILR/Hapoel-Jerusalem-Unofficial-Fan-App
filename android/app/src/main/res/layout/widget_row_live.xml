<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget, one row (and the wide strip) during a live game: the live score card itself (same layout and
     ids as notif_live_card), on the widget's red background and without the play-by-play line -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:background="@drawable/widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- The middle: locked in place -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="108dp"
        android:layout_marginEnd="108dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/notif_pill"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textDirection="rtl"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/info"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textDirection="rtl"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/play"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textDirection="rtl"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Home side (right edge): crest, then the score with its badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/home_crest"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:scaleType="fitCenter" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/home_score"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:includeFontPadding="false"
                android:textSize="28sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ViewFlipper
            android:id="@+id/home_pop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="-2dp"
            android:animateFirstView="true"
            android:autoStart="true"
            android:flipInterval="2200"
            android:inAnimation="@anim/notif_pop_in"
            android:outAnimation="@anim/notif_pop_out"
            android:visibility="invisible">

            <TextView
                android:id="@+id/home_pop_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#D21919"
                android:textDirection="ltr"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />
        </ViewFlipper>
    </LinearLayout>

    <!-- Away side (left edge): the score with its badge, then the crest -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal">

        <ViewFlipper
            android:id="@+id/away_pop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginEnd="-2dp"
            android:animateFirstView="true"
            android:autoStart="true"
            android:flipInterval="2200"
            android:inAnimation="@anim/notif_pop_in"
            android:outAnimation="@anim/notif_pop_out"
            android:visibility="invisible">

            <TextView
                android:id="@+id/away_pop_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#D21919"
                android:textDirection="ltr"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />
        </ViewFlipper>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/away_score"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:includeFontPadding="false"
                android:textSize="28sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageView
            android:id="@+id/away_crest"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:scaleType="fitCenter" />
    </LinearLayout>
</FrameLayout>
