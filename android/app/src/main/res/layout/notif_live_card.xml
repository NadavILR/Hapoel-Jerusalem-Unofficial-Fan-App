<?xml version="1.0" encoding="utf-8"?>
<!-- Live score card: the whole notification is this layout (the app targets SDK 30, so Android does not wrap it
     in its template: no app name, icon or expand arrow, and it never expands). Home team on the right,
     right-to-left whatever the phone's language:

     [home crest] home score⁺²      quarter • clock               ⁺³away score [away crest]
                                    **competition – stage**
                                    the latest play-by-play line

     The middle column has fixed margins (the width of a side), so nothing at the sides can move it. The sides sit
     on top, each in its own space. The +1 / +2 / +3 badge is a ViewFlipper over the corner of the score (towards
     the middle): it pops in when the score changes and fades out on its own, without taking any width. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- The middle: locked in place -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="92dp"
        android:layout_marginEnd="92dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
        android:fontFamily="@font/noto_sans_hebrew"
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/notif_pill"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textDirection="rtl"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
        android:fontFamily="@font/noto_sans_hebrew"
            android:id="@+id/info"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textDirection="rtl"
            android:textSize="11sp" />

        <TextView
        android:fontFamily="@font/noto_sans_hebrew"
            android:id="@+id/play"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textDirection="rtl"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Home side (right edge): crest, then the score with its badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/home_crest"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:scaleType="fitCenter" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
        android:fontFamily="@font/noto_sans_hebrew"
                android:id="@+id/home_score"
                style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:includeFontPadding="false"
                android:textSize="24sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ViewFlipper
            android:id="@+id/home_pop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="-2dp"
            android:animateFirstView="true"
            android:autoStart="true"
            android:flipInterval="2200"
            android:inAnimation="@anim/notif_pop_in"
            android:outAnimation="@anim/notif_pop_out"
            android:visibility="invisible">

            <TextView
        android:fontFamily="@font/noto_sans_hebrew"
                android:id="@+id/home_pop_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#D21919"
                android:textDirection="ltr"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
        android:fontFamily="@font/noto_sans_hebrew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />
        </ViewFlipper>
    </LinearLayout>

    <!-- Away side (left edge): the score with its badge, then the crest -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal">

        <ViewFlipper
            android:id="@+id/away_pop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginEnd="-2dp"
            android:animateFirstView="true"
            android:autoStart="true"
            android:flipInterval="2200"
            android:inAnimation="@anim/notif_pop_in"
            android:outAnimation="@anim/notif_pop_out"
            android:visibility="invisible">

            <TextView
        android:fontFamily="@font/noto_sans_hebrew"
                android:id="@+id/away_pop_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#D21919"
                android:textDirection="ltr"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
        android:fontFamily="@font/noto_sans_hebrew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />
        </ViewFlipper>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
        android:fontFamily="@font/noto_sans_hebrew"
                android:id="@+id/away_score"
                style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:includeFontPadding="false"
                android:textSize="24sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageView
            android:id="@+id/away_crest"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:scaleType="fitCenter" />
    </LinearLayout>
</FrameLayout>
