<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget, one row and the wide strip, before the game (the user's design): the crests at the two ends
     (home on the right); in the middle the competition and stage (bold), the day, date and time, and four countdown boxes
     – days, hours, minutes, seconds. Days and hours are text (the widget is refreshed every hour); minutes and seconds
     tick by themselves (two clocks, each showing only its own digits). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_bg" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:layoutDirection="rtl">
  <ImageView android:id="@+id/w_home_crest" android:layout_width="58dp" android:layout_height="58dp" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp">
    <TextView android:id="@+id/w_comp" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFFFFF" android:textSize="13dp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    <TextView android:id="@+id/w_when" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#E6FFFFFF" android:textSize="12dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="2dp" />
    <TextView android:id="@+id/w_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/widget_box" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:textColor="#FFFFFF" android:textSize="14dp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
    <LinearLayout android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center" android:layoutDirection="ltr">
        <LinearLayout android:id="@+id/w_days_box" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="46dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_box" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp">
          <TextView android:id="@+id/w_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="22dp" android:textStyle="bold" android:includeFontPadding="false" android:fontFeatureSettings="tnum" android:text="00" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="10dp" android:includeFontPadding="false" android:layout_marginTop="2dp" android:text="ימים" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="46dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_box" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp">
          <TextView android:id="@+id/w_hours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="22dp" android:textStyle="bold" android:includeFontPadding="false" android:fontFeatureSettings="tnum" android:text="00" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="10dp" android:includeFontPadding="false" android:layout_marginTop="2dp" android:text="שעות" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="46dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_box" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp">
          <FrameLayout android:id="@+id/w_mm_clip" android:layout_width="27dp" android:layout_height="wrap_content" android:layoutDirection="ltr">
            <Chronometer android:id="@+id/w_chrono" android:layout_width="160dp" android:layout_height="wrap_content" android:layout_gravity="start" android:gravity="start" android:textAlignment="viewStart" android:layoutDirection="ltr" android:textDirection="ltr" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="22dp" android:textStyle="bold" android:includeFontPadding="false" android:fontFeatureSettings="tnum" />
          </FrameLayout>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="10dp" android:includeFontPadding="false" android:layout_marginTop="2dp" android:text="דקות" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="46dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_box" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp">
          <FrameLayout android:id="@+id/w_ss_clip" android:layout_width="27dp" android:layout_height="wrap_content" android:layoutDirection="ltr">
            <Chronometer android:id="@+id/w_chrono2" android:layout_width="160dp" android:layout_height="wrap_content" android:layout_gravity="end" android:gravity="end" android:textAlignment="viewEnd" android:layoutDirection="ltr" android:textDirection="ltr" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="22dp" android:textStyle="bold" android:includeFontPadding="false" android:fontFeatureSettings="tnum" />
          </FrameLayout>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="10dp" android:includeFontPadding="false" android:layout_marginTop="2dp" android:text="שניות" />
        </LinearLayout>
    </LinearLayout>
  </LinearLayout>
  <ImageView android:id="@+id/w_away_crest" android:layout_width="58dp" android:layout_height="58dp" android:scaleType="fitCenter" android:src="@drawable/hpj_crest" android:importantForAccessibility="no" />
</LinearLayout>
