<?xml version="1.0" encoding="utf-8"?>
<!-- Clock widget card: dark glass (ink), a soft red glow behind the crest (top right), a fine light outline. Radius 20dp,
     padding 10dp – the elements in its corners are rounded 10dp (inner = outer − padding) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><corners android:radius="20dp" /><gradient android:angle="270" android:startColor="#DB2C2C2C" android:endColor="#D1181818" /></shape></item>
    <item><shape android:shape="rectangle"><corners android:radius="20dp" /><gradient android:type="radial" android:centerX="1" android:centerY="0" android:gradientRadius="230dp" android:startColor="#8CD21919" android:endColor="#00D21919" /></shape></item>
    <item><shape android:shape="rectangle"><corners android:radius="20dp" /><solid android:color="#00000000" /><stroke android:width="1dp" android:color="#24FFFFFF" /></shape></item>
</layer-list>
